{
  "name": "@taskloom/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "GraphQL schema and TypeScript contracts shared by api and web",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./schema.graphql": "./schema.graphql"
  },
  "files": [
    "dist",
    "schema.graphql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit"
  }
}
