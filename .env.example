# PostgreSQL bootstrap superuser (docker init only, never used by the app)
POSTGRES_SUPERUSER_PASSWORD=postgres_dev

# Migrations: app_owner over a direct connection
APP_OWNER_PASSWORD=app_owner_dev
DIRECT_DATABASE_URL=postgresql://app_owner:app_owner_dev@localhost:5432/taskloom
SHADOW_DATABASE_URL=postgresql://app_owner:app_owner_dev@localhost:5432/taskloom_shadow

# API runtime: app_runtime (no privileges of its own) through PgBouncer in transaction mode
APP_RUNTIME_PASSWORD=app_runtime_dev
DATABASE_URL=postgresql://app_runtime:app_runtime_dev@localhost:6432/taskloom

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
DB_TX_TIMEOUT_MS=5000
DB_TX_MAX_WAIT_MS=2000

# Web (exposed to the browser)
VITE_API_URL=http://localhost:4000
