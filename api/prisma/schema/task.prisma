// Tasks, labels, and comments. Hot-path indexes are partial on live rows
// (archived_at IS NULL), so archives stay off the board, overdue, and filter paths.

model Task {
  orgId       String    @map("org_id") @db.Uuid
  id          String    @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  // Allocated by the insert trigger. 0 is the placeholder Prisma sends; any other value fails.
  number      Int       @default(0)
  title       String
  description String?
  statusId    String    @map("status_id") @db.Uuid
  isClosed    Boolean   @default(false) @map("is_closed")
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  priority    Int?      @db.SmallInt
  assigneeId  String?   @map("assignee_id") @db.Uuid
  dueDate     DateTime  @map("due_date") @db.Date
  // Base-62 fractional key, COLLATE "C" in SQL so database order equals JavaScript order.
  // Generated by the insert trigger (top of the column). "" is the placeholder Prisma sends.
  rank        String    @default("")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  project  Project        @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: NoAction, onUpdate: NoAction)
  status   ProjectStatus  @relation(fields: [orgId, projectId, statusId], references: [orgId, projectId, id], onDelete: NoAction, onUpdate: NoAction)
  assignee OrgMembership? @relation("TaskAssignee", fields: [orgId, assigneeId], references: [orgId, userId], onDelete: NoAction, onUpdate: NoAction)
  creator  OrgMembership  @relation("TaskCreator", fields: [orgId, createdBy], references: [orgId, userId], onDelete: NoAction, onUpdate: NoAction)

  labels         TaskLabel[]
  comments       Comment[]
  activityEvents ActivityEvent[]

  @@id([orgId, id])
  @@unique([orgId, projectId, number], map: "tasks_number_unique")
  // Deferrable in SQL so a rebalance can rewrite ranks in one transaction.
  @@unique([orgId, projectId, rank], map: "tasks_rank_unique")
  @@index([orgId, projectId, statusId, rank], map: "tasks_board", where: raw("(archived_at IS NULL)"))
  @@index([orgId, projectId, id], map: "tasks_project_created", where: raw("(archived_at IS NULL)"))
  @@index([orgId, id], map: "tasks_org_created", where: raw("(archived_at IS NULL)"))
  @@index([orgId, projectId, dueDate], map: "tasks_project_due", where: raw("(archived_at IS NULL)"))
  @@index([orgId, projectId, assigneeId], map: "tasks_project_assignee", where: raw("(archived_at IS NULL)"))
  @@index([orgId, assigneeId, dueDate], map: "tasks_overdue_by_assignee", where: raw("((archived_at IS NULL) AND (NOT is_closed))"))
  @@index([orgId, projectId, statusId], map: "tasks_by_status")
  @@index([orgId, assigneeId], map: "tasks_open_by_assignee", where: raw("((NOT is_closed) AND (assignee_id IS NOT NULL))"))
  @@index([orgId, projectId, archivedAt(sort: Desc)], map: "tasks_archived", where: raw("(archived_at IS NOT NULL)"))
  @@map("tasks")
}

model Label {
  orgId      String    @map("org_id") @db.Uuid
  id         String    @default(dbgenerated("uuidv7()")) @db.Uuid
  name       String
  // One of the design system's ten label color tokens (checked in SQL).
  color      String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks        TaskLabel[]

  @@id([orgId, id])
  @@map("labels")
}

model TaskLabel {
  orgId     String   @map("org_id") @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  labelId   String   @map("label_id") @db.Uuid
  createdAt DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)

  task  Task  @relation(fields: [orgId, taskId], references: [orgId, id], onDelete: NoAction, onUpdate: NoAction)
  label Label @relation(fields: [orgId, labelId], references: [orgId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([orgId, taskId, labelId])
  @@index([orgId, labelId, taskId], map: "task_labels_by_label")
  @@map("task_labels")
}

model Comment {
  orgId     String    @map("org_id") @db.Uuid
  id        String    @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  // Null exactly when the comment is deleted (checked in SQL).
  body      String?
  createdAt DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  task    Task           @relation(fields: [orgId, taskId], references: [orgId, id], onDelete: NoAction, onUpdate: NoAction)
  author  OrgMembership  @relation("CommentAuthor", fields: [orgId, authorId], references: [orgId, userId], onDelete: NoAction, onUpdate: NoAction)
  deleter OrgMembership? @relation("CommentDeleter", fields: [orgId, deletedBy], references: [orgId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@id([orgId, id])
  @@index([orgId, taskId, createdAt, id], map: "comments_timeline")
  @@index([orgId, taskId], map: "comments_live_count", where: raw("(deleted_at IS NULL)"))
  @@map("comments")
}
