    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
